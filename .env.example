# ─── Domaine & HTTPS (Caddy) ───
DOMAIN=www.exemple.fr
ACME_EMAIL=contact@exemple.fr

# ─── Public (intégré au build, visible côté navigateur) ───
NEXT_PUBLIC_SITE_URL=https://www.exemple.fr
NEXT_PUBLIC_SITE_NAME=Nom de la boutique
NEXT_PUBLIC_MEDIA_URL=https://media.exemple.fr        # domaine public du bucket d'images
NEXT_PUBLIC_GA_ID=                                    # G-XXXXXXXXXX (vide = pas d'Analytics)
GOOGLE_SITE_VERIFICATION=                             # jeton Search Console (balise meta)

# ─── Base de données ───
# Propriétaire du schéma : utilisé UNIQUEMENT par les migrations et les sauvegardes.
POSTGRES_USER=reptile
POSTGRES_PASSWORD=                                    # openssl rand -hex 32
POSTGRES_DB=reptile
# Rôle d'exécution de l'application et du worker (DML seul, ni DDL, ni TRUNCATE, ni contournement RLS).
# Créé automatiquement à l'initialisation du volume (deploy/postgres-init/10-app-role.sh).
APP_DB_USER=reptile_app
APP_DB_PASSWORD=                                      # openssl rand -hex 32 (hexadécimal : sûr dans une URL)
# En local uniquement (docker-compose le calcule automatiquement en production) :
DATABASE_URL=postgresql://reptile:motdepasse@localhost:5432/reptile

# ─── File de travaux (Redis + worker) ───
REDIS_PASSWORD=                                       # openssl rand -hex 32
# En local uniquement (docker-compose le calcule en production) :
REDIS_URL=redis://127.0.0.1:6379/0

# ─── Authentification ───
BETTER_AUTH_SECRET=                                   # openssl rand -base64 48

# ─── Stripe ───
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Emails (Resend) ───
RESEND_API_KEY=re_...
EMAIL_FROM="Nom de la boutique <commandes@exemple.fr>"
ADMIN_NOTIFY_EMAIL=equipe@exemple.fr

# ─── Stockage objet (Cloudflare R2 ou AWS S3) ───
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com   # vide pour AWS S3
S3_REGION=auto                                               # ex. eu-west-3 pour AWS
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_PRIVATE=reptile-private                            # documents + factures (jamais public)
S3_BUCKET_PUBLIC=reptile-media                               # images produits (domaine public)

# ─── Divers ───
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
UPLOAD_MAX_MB=10

# ─── Environnement & politique commerciale ───
APP_ENV=production                                    # development | staging | production
# Âge minimum pour créer un compte : POLITIQUE COMMERCIALE de la boutique (pas une référence légale).
# L'âge requis pour acheter un animal se configure dans les règles de conformité (admin).
MINIMUM_ACCOUNT_AGE=18
# Double authentification obligatoire pour le personnel (défaut : oui hors APP_ENV=development).
STAFF_REQUIRE_2FA=true
LOG_LEVEL=info                                        # debug | info | warn | error
APP_VERSION=                                          # facultatif : version affichée dans Santé système

# ─── Limites de débit (facultatif) : RATE_LIMIT_<NOM>=max/fenêtre_en_secondes ───
# Valeurs par défaut : CART 60/60, CHECKOUT 10/600, CONTACT 5/3600, COUPON 10/600, DOCUMENTS 20/3600, SEARCH 120/60
# RATE_LIMIT_CHECKOUT=10/600

# ─── Sauvegardes ───
BACKUP_CRON=30 3 * * *
BACKUP_RETENTION_DAYS=14
BACKUP_S3_BUCKET=                                     # bucket dédié aux sauvegardes (autre compte conseillé)
BACKUP_S3_PROVIDER=Cloudflare                         # ou AWS
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=auto
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
HEALTHCHECK_URL=                                      # ex. https://hc-ping.com/<uuid> (alerte si échec/absence)
